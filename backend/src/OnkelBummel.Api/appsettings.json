{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "PublicUrl": null,
    "UseForwardedHeaders": false
  },
  "Storage": {
    "DataPath": "local-data"
  },
  "Limits": {
    "MaxFileBytes": 20971520,
    "MaxFilesPerMessage": 10,
    "MaxRequestBytes": 104857600
  },
  "Oidc": {
    "Issuer": null,
    "Audience": "onkel-bummel-api",
    "WebClientId": "onkel-bummel-web",
    "IosClientId": "onkel-bummel-ios",
    "RequiredRole": "onkel-bummel"
  },
  "Apns": {
    "BundleId": "de.bvelop.onkelbummel"
  },
  "Monitoring": {
    "MetricsPort": 9464
  },
  "Backup": {
    "At": "03:30"
  },
  "Jobs": {
    "Enabled": true,
    "MaintenanceAt": "04:15"
  }
}
