# Kopieren nach .env und ausfüllen. .env und secrets/ stehen in .gitignore.

# Tailscale: Auth Key aus der Admin-Konsole (Settings > Keys), nur für den ersten Start nötig.
# Ohne Key steht im Log ein Login-Link (docker compose logs tailscale).
TS_AUTHKEY=
# Name des Tailnets, wie in <name>.<tailnet>.ts.net, z. B. tail1234
TS_TAILNET=

# Identity-Server und das Secret des Clients onkel-bummel-web (aus <Issuer>/Admin/Clients)
OIDC_ISSUER=https://identity.<tailnet>.ts.net
OIDC_WEB_CLIENT_SECRET=

# APNs: Key ID und Team ID aus dem Apple-Developer-Account; der Schlüssel selbst liegt in secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=

# Monitoring (optional): Loki im Monitoring-LXC und der Name für das host-Label
LOKI_URL=http://monitoring:3100
MONITORING_HOST=onkel-bummel

# Nächtliche Sicherung in die Nextcloud (optional); der Ordner darüber muss existieren
NEXTCLOUD_WEBDAV_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
BACKUP_PASSPHRASE=
